# Copia este archivo como .env (en la raíz del proyecto) y rellénalo. .env NO se sube a git.

# Cuenta de TikTok cuyo LIVE se escucha (sin @). Si está vacío, el puente arranca en modo mock.
TIKTOK_USER=

# Opcional: API key del servidor de firma de Euler Stream (sube los límites del nivel gratuito).
EULER_SIGN_API_KEY=

# auto (TikTok si hay TIKTOK_USER, si no mock) | tiktok | mock
BRIDGE_MODE=auto

# Puerto del servidor local (siempre escucha solo en 127.0.0.1)
BRIDGE_PORT=8080
